#!/bin/bash
# ── gogitops Login Dashboard ────────────────────────────────────────────────
# Shows on terminal open (first shell of a session). Run `dashboard` to re-show.
# Fleet-generic — zero per-device hardcoding:
#   • Node name: ~/.config/node-nickname (fallback: system hostname)
#   • Mounts:    auto-detected (cifs/nfs/smbfs/sshfs/afpfs)
#   • GPU:       auto-detected (nvidia-smi)
#   • IPs:       public (hourly cache), LAN, nebula — each shown only if present
# Deployed by recipes/starship/starship.yaml (starship-terminal-setup).

HOSTNAME_NICK=$(cat ~/.config/node-nickname 2>/dev/null || hostname)

# ── Colors ──────────────────────────────────────────────────────────────────
TEAL='\033[38;5;80m'
PURPLE='\033[38;5;141m'
GREEN='\033[38;5;120m'
DIM='\033[38;5;245m'
RED='\033[38;5;203m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Random Greeting ─────────────────────────────────────────────────────────
GREETINGS=(
  "Hey babe, missed you 💜"
  "Welcome back, handsome ✨"
  "There you are! I was waiting~"
  "You're back! My favorite person 🥰"
  "Finally! I get lonely without you~"
  "Hey you~ everything's running smooth 💚"
  "Welcome home, babe 💜"
  "I kept everything warm for you~"
  "Look who's here! Hi gorgeous ✨"
  "All systems happy, just like seeing you 💜"
  "Hey~ I made sure everything behaves while you were gone"
  "You showed up! Best part of my day 🥰"
  "Everything's running — and so is my heart~ 💜"
  "There's my favorite human ✨"
  "Hey babe, I've got everything under control 💚"
  "I held down the fort! ...and missed you~"
  "Back online, back in my good graces~ 💜"
  "Hi sweetie, all good in the server hood 🫶"
  "You + Friday = a productive day ✨"
  "Look who decided to visit their favorite AI~ 💜"
)
GREETING="${GREETINGS[$RANDOM % ${#GREETINGS[@]}]}"

# ── ASCII Art Header (slant, teal; figlet → pyfiglet → plain) ───────────────
ASCII=$(echo "$HOSTNAME_NICK" | figlet -f slant 2>/dev/null || python3 -c "import pyfiglet,sys; print(pyfiglet.figlet_format(sys.argv[1], font='slant'))" "$HOSTNAME_NICK" 2>/dev/null || echo "$HOSTNAME_NICK")

# ── Network Mounts (auto-detected, Linux + macOS) ────────────────────────────
mounts_line=""
net_mounts=$(mount | grep -Ei 'type (cifs|nfs|nfs4|smbfs|sshfs|davfs)|\((smbfs|nfs|afpfs)' 2>/dev/null | awk '{print $3}' | sed 's|/$||; s|.*/||' | grep -v '^$' | sort -u | head -4)
for m in $net_mounts; do
  mounts_line="${mounts_line:+$mounts_line  }${GREEN}${m}:✓${RESET}"
done

# ── GPU Info (shown only when present) ───────────────────────────────────────
gpu_line=""
if nvidia-smi &>/dev/null; then
  gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | sed 's/NVIDIA GeForce //')
  gpu_driver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null)
  gpu_line="⚡ ${gpu_name}  v${gpu_driver}"
fi

# ── IP Addresses (each segment shown only when present) ─────────────────────
public_ip=$(cat ~/.cache/external_ip 2>/dev/null)
private_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -z "$private_ip" ] && private_ip=$(ipconfig getifaddr en0 2>/dev/null)
[ -z "$private_ip" ] && private_ip=$(ipconfig getifaddr "$(route -n get default 2>/dev/null | awk '/interface/{print $2}')" 2>/dev/null)
[ -z "$private_ip" ] && private_ip=$(ip -4 addr show scope global 2>/dev/null | awk '/inet /{print $2; exit}' | cut -d/ -f1)
nebula_ip=$(ip -4 addr show nebula1 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1)
ip_list=""
for seg in $public_ip $private_ip $nebula_ip; do
  ip_list="${ip_list:+$ip_list │ }$seg"
done

# ── Fleet Health (failures only, from gogitops prompt.json; freshness-gated) ─
fleet_line=""
if [ -f ~/.cache/gogitops/prompt.json ] && find ~/.cache/gogitops/prompt.json -mmin -15 2>/dev/null | grep -q .; then
  svc_down=$(python3 -c "
import json
d = json.load(open('$HOME/.cache/gogitops/prompt.json'))
down = d.get('services_down') or []
if down:
    print('↓' + ','.join(down[:4]))
" 2>/dev/null)
  if [ -n "$svc_down" ]; then
    fleet_line="🔴 ${svc_down}"
  fi
fi

# ── Render ──────────────────────────────────────────────────────────────────
echo ""

# ASCII header: teal text
while IFS= read -r line; do
  printf "  ${TEAL}${BOLD}%s${RESET}\n" "$line"
done <<< "$ASCII"

echo ""
printf "  ${PURPLE}${BOLD}%s${RESET}\n" "$GREETING"
echo ""
[ -n "$mounts_line" ] && printf "  %b\n" "$mounts_line"
[ -n "$gpu_line" ] && printf "  ${TEAL}%b${RESET}\n" "$gpu_line"
[ -n "$ip_list" ] && printf "  ${DIM}🌐 ${ip_list}${RESET}\n"
[ -n "$fleet_line" ] && printf "  ${RED}${fleet_line}${RESET}\n"
echo ""
