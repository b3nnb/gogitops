[Unit]
Description=GoGitOps Daemon — agent mesh health checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gogitops daemon -repo /etc/gogitops -bind 0.0.0.0 -port 7780 -interval 60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
