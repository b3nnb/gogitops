[Unit]
Description=GoGitOps Daemon — fleet health checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Defaults — overridden by /etc/gogitops/agent.env
Environment=GOGITOPS_BIND=0.0.0.0
Environment=GOGITOPS_PORT=7780
Environment=GOGITOPS_INTERVAL=60
Environment=GOGITOPS_REPO_DIR=%h/.config/gogitops
EnvironmentFile=-/etc/gogitops/agent.env
# All flags passed unconditionally — plain ${VAR} expansion is native systemd
# and survives where bash's ${VAR:+...} conditionals did not (systemd pre-expands
# ExecStart and mangles nested-quote :+ syntax, silently dropping -dashboard/
# -hostname — the reason no Linux agent ever beacon-registered; fixed Sep 2026).
# Empty -dashboard "" / -hostname "" are no-ops in the Go flag handling.
ExecStart=/usr/local/bin/gogitops daemon -repo "${GOGITOPS_REPO_DIR}" -bind "${GOGITOPS_BIND}" -port "${GOGITOPS_PORT}" -interval "${GOGITOPS_INTERVAL}" -dashboard "${GOGITOPS_DASHBOARD_URL}" -hostname "${GOGITOPS_HOSTNAME}"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
