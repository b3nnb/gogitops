#!/bin/bash
set -e

USER="${SUDO_USER:-benn}"
USER_HOME="/home/$USER"
USER_UID=$(id -u "$USER" 2>/dev/null || echo 1000)
XDG="XDG_RUNTIME_DIR=/run/user/$USER_UID"

# ── 1. Fix non-interactive SSH shell hang ─────────────────────
BASHRC="$USER_HOME/.bashrc"
if ! head -5 "$BASHRC" 2>/dev/null | grep -q '!= \*i\*'; then
    TMP=$(mktemp)
    {
        echo '# Return early for non-interactive shells (fixes SSH hang)'
        echo '[[ $- != *i* ]] && return'
        cat "$BASHRC" 2>/dev/null || true
    } > "$TMP"
    chown "$USER" "$TMP"
    mv "$TMP" "$BASHRC"
fi

# ── 2. Set up SSH authorized_keys.d ───────────────────────────
mkdir -p "$USER_HOME/.ssh/authorized_keys.d"
if [ -f /etc/gogitops/ssh/friday-automation.pub ]; then
    cp /etc/gogitops/ssh/friday-automation.pub "$USER_HOME/.ssh/authorized_keys.d/"
    chown -R "$USER" "$USER_HOME/.ssh/authorized_keys.d"
    chmod 600 "$USER_HOME/.ssh/authorized_keys.d/friday-automation.pub"
fi

# ── 3. Create gogitops config file ────────────────────────────
CONFIG_FILE="/etc/gogitops/config.yaml"
if [ ! -f "$CONFIG_FILE" ]; then
    cat > "$CONFIG_FILE" << EOF
# gogitops configuration
webhook: ""
bind: "0.0.0.0"
port: 7780
interval: 60
EOF
    chmod 644 "$CONFIG_FILE"
fi

# ── 4. Ask for Discord webhook (interactive only) ─────────────
if [ -t 0 ]; then
    CURRENT_WEBHOOK=$(grep '^webhook:' "$CONFIG_FILE" 2>/dev/null | sed 's/webhook: *"\?\([^"]*\)"\?/\1/')
    if [ -z "$CURRENT_WEBHOOK" ]; then
        echo ""
        echo "gogitops can send health alerts to Discord (optional)."
        echo "Get a webhook: Discord → Server Settings → Integrations → Webhooks"
        read -rp "Discord webhook URL (Enter to skip): " WEBHOOK_URL
        if [ -n "$WEBHOOK_URL" ]; then
            sed -i "s|^webhook: .*|webhook: \"$WEBHOOK_URL\"|" "$CONFIG_FILE"
            echo "  ✓ Discord alerts configured"
        fi
    fi
fi

# ── 5. NetEnv integration (default: OFF) ──────────────────────
# nenv-agent binary is always installed, but the service is NOT enabled
# unless the user opts in. Three ways to opt in:
#   a) Interactive: answer "y" to the prompt below
#   b) Pre-seeded:  GOGITOPS_NETENV=1 sudo dpkg -i gogitops.deb
#   c) Post-install: edit service + enable manually (instructions printed)

NETENV_ENABLED=0
NETENV_SERVER=""
NETENV_TOKEN=""

# Check env var pre-seed
if [ "${GOGITOPS_NETENV:-0}" = "1" ]; then
    NETENV_ENABLED=1
    NETENV_SERVER="${GOGITOPS_NETENV_SERVER:-http://10.2.0.102:7200}"
    NETENV_TOKEN="${GOGITOPS_NETENV_TOKEN:-}"
fi

# Interactive prompt
if [ "$NETENV_ENABLED" = "0" ] && [ -t 0 ]; then
    echo ""
    echo "NetEnv integration (secrets distribution) is available but OFF by default."
    echo "Enable it if you have a NetEnv server running on your network."
    read -rp "Enable NetEnv? [y/N]: " RESPONSE
    case "$RESPONSE" in
        y|Y|yes|YES)
            NETENV_ENABLED=1
            read -rp "NetEnv server URL [http://10.2.0.102:7200]: " INPUT_SERVER
            NETENV_SERVER="${INPUT_SERVER:-http://10.2.0.102:7200}"
            read -rp "NetEnv agent token: " NETENV_TOKEN
            ;;
    esac
fi

# Render nenv-agent service (always installed, only enabled if opted in)
NENV_SERVICE="/usr/lib/systemd/user/nenv-agent.service"
if [ "$NETENV_ENABLED" = "1" ]; then
    sed -i "s|__NENV_SERVER__|$NETENV_SERVER|g" "$NENV_SERVICE"
    if [ -n "$NETENV_TOKEN" ]; then
        sed -i "s|__NENV_TOKEN__|$NETENV_TOKEN|g" "$NENV_SERVICE"
    else
        echo "  ⚠ No token provided. Edit $NENV_SERVICE to set __NENV_TOKEN__"
        echo "    Then: systemctl --user daemon-reload && systemctl --user enable --now nenv-agent"
        NETENV_ENABLED=0
    fi
else
    # Render with placeholders replaced by comments so the file is valid but inert
    sed -i "s|__NENV_SERVER__|# Configure server then uncomment: http://10.2.0.102:7200|" "$NENV_SERVICE"
    sed -i "s|__NENV_TOKEN__|# Configure token then uncomment: your-token-here|" "$NENV_SERVICE"
fi

# ── 6. Reload systemd ─────────────────────────────────────────
if [ -n "$SUDO_USER" ]; then
    sudo -u "$SUDO_USER" $XDG systemctl --user daemon-reload 2>/dev/null || true
fi

# ── 7. Enable and start gogitops daemon (always) ──────────────
if [ -n "$SUDO_USER" ]; then
    if sudo -u "$SUDO_USER" $XDG systemctl --user enable --now gogitops-daemon.service 2>/dev/null; then
        echo "  ✓ gogitops-daemon enabled and started"
        echo "  → Node will self-register to the mesh on first check-in"
    else
        echo "  ⚠ gogitops-daemon failed to start"
        echo "    Check: systemctl --user status gogitops-daemon"
    fi

    # nenv-agent (only if opted in)
    if [ "$NETENV_ENABLED" = "1" ]; then
        if sudo -u "$SUDO_USER" $XDG systemctl --user enable --now nenv-agent.service 2>/dev/null; then
            echo "  ✓ nenv-agent enabled and started (server: $NETENV_SERVER)"
        else
            echo "  ⚠ nenv-agent failed to start"
            echo "    Check: systemctl --user status nenv-agent"
        fi
    else
        echo "  → nenv-agent installed but NOT enabled (standalone mode)"
        echo "    To enable later: edit $NENV_SERVICE, then:"
        echo "    systemctl --user daemon-reload && systemctl --user enable --now nenv-agent"
    fi
fi

echo ""
echo "=== gogitops installed ==="
echo ""
echo "Binary:   /usr/local/bin/gogitops"
echo "Config:   /etc/gogitops/config.yaml"
echo "Mesh:     /etc/gogitops/mesh.yaml (auto-updated on registration)"
echo "Services: gogitops-daemon (running), nenv-agent (${NETENV_ENABLED})"
echo ""
echo "Commands:"
echo "  gogitops status          — check local node health"
echo "  gogitops mesh            — list mesh peers"
